{
  "name": "quantum-notepad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-notices.mjs && node scripts/export-help.mjs && tsc --noEmit && vite build && node scripts/export-standalone.mjs",
    "help:export": "node scripts/export-help.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "node scripts/android-apk.mjs",
    "licenses:generate": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
